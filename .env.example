# clipmux serve
DATABASE_URL=postgres://clipmux:clipmux@localhost:5444/clipmux?sslmode=disable
CLIPMUX_LISTEN=:8080
CLIPMUX_DATA_DIR=./data
# Origin browsers and workers reach the app at; signed storage URLs use it.
CLIPMUX_PUBLIC_URL=http://localhost:8080
# Real-Postgres test suites (skipped when unset)
TEST_DATABASE_URL=postgres://clipmux:clipmux@localhost:5444/clipmux_test?sslmode=disable
