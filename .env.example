# clipmux serve
DATABASE_URL=postgres://clipmux:clipmux@localhost:5444/clipmux?sslmode=disable
CLIPMUX_LISTEN=:8080
CLIPMUX_DATA_DIR=./data
# Key that seals the secrets kept in Postgres ("v1:" + 64 hex digits, e.g.
# echo "v1:$(openssl rand -hex 32)"). Unset, serve creates
# $CLIPMUX_DATA_DIR/secrets.key on first boot. Back it up: without it, stored
# secrets (and, from T10, every output) can't be opened.
# CLIPMUX_SECRETS_KEY=
# Origin browsers and workers reach the app at; signed storage URLs use it.
# Unset, the owner chooses it at first boot (default http://localhost:8080).
# Set, it pins both URLs and the first-boot URL step is read-only. No API key
# can be created while it is loopback (admin create-key --allow-loopback for
# local development).
# CLIPMUX_PUBLIC_URL=https://video.example.com
# Origin playback is served from, returned to apps as base_url. Defaults to
# CLIPMUX_PUBLIC_URL; ideally a different registrable domain from the
# dashboard. Needs CLIPMUX_PUBLIC_URL.
# CLIPMUX_MEDIA_URL=https://media.example.net
# Largest declared upload in bytes; unset means the storage limit (~312 GiB).
# CLIPMUX_MAX_UPLOAD_BYTES=26843545600
# serve runs `clipmux worker` as a child unless this is false.
# CLIPMUX_BUILTIN_WORKER=true
# Proxies (e.g. Caddy) whose X-Forwarded-For is believed when limiting
# sign-ins: comma-separated addresses or CIDR ranges.
# CLIPMUX_TRUSTED_PROXIES=172.16.0.0/12
# Logs (serve, its built-in worker and agents): text or json, and the lowest
# level written (debug, info, warn or error). Every request logs one line,
# with tokens, pairing codes, keys and URL signatures redacted; successful
# playback, storage and worker traffic logs at debug.
# CLIPMUX_LOG_FORMAT=text
# CLIPMUX_LOG_LEVEL=info
# Prometheus metrics on an address of their own (never the public listener;
# keep it off the internet, it has no auth), and Go's pprof beside them.
# CLIPMUX_METRICS_ADDR=127.0.0.1:9090
# CLIPMUX_PPROF=false
# DATABASE_URL may set pgxpool options (pool_max_conns=20) and session
# settings; unset, every session gets statement_timeout=60s and
# idle_in_transaction_session_timeout=5min. serve waits up to a minute for
# Postgres at boot.
# The built-in worker confines ffmpeg and the packager (seccomp, Landlock,
# limits, idle priority) and stays off where that doesn't hold. Set true only
# if the host isolates the worker another way.
# CLIPMUX_UNSANDBOXED_WORKER=false
# Address-space limit per media tool, in MiB (default 8192).
# CLIPMUX_TOOL_MEMORY_MB=8192
# Where the setup test connects for every URL it checks, keeping the URL's
# hostname for TLS (compose sets caddy:443).
# CLIPMUX_SELF_DIAL=caddy:443
# Media tools; default: found on PATH. Shaka Packager must be >= 3.9.1
# (toolchain/install_packager.sh installs the pinned build).
# CLIPMUX_FFMPEG=ffmpeg
# CLIPMUX_FFPROBE=ffprobe
# CLIPMUX_PACKAGER=packager
# CLIPMUX_WHISPER=whisper-cli
# The previous secrets key, only while rotating (clipmux admin reseal-secrets).
# CLIPMUX_SECRETS_KEY_PREVIOUS=
# Overrides for an API proxy or a test double, and the worker image provider
# machines run (default: the image this build was made for).
# CLIPMUX_CLOUDFLARE_API=https://api.cloudflare.com/client/v4
# CLIPMUX_R2_ENDPOINT=https://{account_id}.r2.cloudflarestorage.com
# CLIPMUX_RUNPOD_API=https://rest.runpod.io/v1
# CLIPMUX_RUNPOD_CATALOG=https://api.runpod.io/v2
# CLIPMUX_WORKER_IMAGE=ghcr.io/visheshgubrani/clipmux:sha-…
# Let RunPod or Modal connect while the public URL is private (development
# only: their machines couldn't reach this server).
# CLIPMUX_EXECUTORS_ALLOW_PRIVATE_URL=false

# clipmux worker (a PC agent, or the built-in worker serve starts)
# The server and the key; an agent paired with --pair keeps both in its
# agent.json and needs neither. Never put a key in argv.
# CLIPMUX_SERVER=https://video.example.com
# CLIPMUX_WORKER_KEY=
# CLIPMUX_AGENT_DIR=~/.config/clipmux
# First encoder to try (auto, nvenc, vaapi, cuda-decode, cpu), whether to
# transcribe (auto, off, cpu, vulkan) and where the speech models go, and the VAAPI
# render node.
# CLIPMUX_ENCODER=auto
# CLIPMUX_SPEECH=auto
# CLIPMUX_BAKED_MODELS_DIR=/usr/share/clipmux/models
# CLIPMUX_MODELS_DIR=
# CLIPMUX_VAAPI_DEVICE=/dev/dri/renderD128

# clipmux push and clipmux listen
# CLIPMUX_API_KEY=cmx_…
# CLIPMUX_PUSH_STATE_DIR=~/.cache/clipmux/push
# CLIPMUX_LISTEN_SECRET=whsec_…
# listen also takes the server from the SDK's env file when CLIPMUX_SERVER is unset
# CLIPMUX_URL=https://video.example.com

# Real-Postgres test suites (skipped when unset)
TEST_DATABASE_URL=postgres://clipmux:clipmux@localhost:5444/clipmux_test?sslmode=disable
