# clipmux serve
DATABASE_URL=postgres://clipmux:clipmux@localhost:5444/clipmux?sslmode=disable
CLIPMUX_LISTEN=:8080
CLIPMUX_DATA_DIR=./data
# Origin browsers and workers reach the app at; signed storage URLs use it.
CLIPMUX_PUBLIC_URL=http://localhost:8080
# Largest declared upload in bytes; unset means the storage limit (~312 GiB).
# CLIPMUX_MAX_UPLOAD_BYTES=26843545600
# serve runs `clipmux worker` as a child unless this is false.
# CLIPMUX_BUILTIN_WORKER=true
# Media tools; default: found on PATH. Shaka Packager must be >= 3.9.1
# (toolchain/install_packager.sh installs the pinned build).
# CLIPMUX_FFMPEG=ffmpeg
# CLIPMUX_FFPROBE=ffprobe
# CLIPMUX_PACKAGER=packager
# Real-Postgres test suites (skipped when unset)
TEST_DATABASE_URL=postgres://clipmux:clipmux@localhost:5444/clipmux_test?sslmode=disable
