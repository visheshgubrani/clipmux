# Copy to deploy/.env for deploy/compose.yml. Never commit the copy.

# Postgres password for the bundled database.
POSTGRES_PASSWORD=

# Seals the secrets ClipMux keeps in Postgres. Generate once and back it up
# with the database: without it, stored secrets and every output are lost.
#   echo "v1:$(openssl rand -hex 32)"
CLIPMUX_SECRETS_KEY=

# Optional: pin the URLs instead of choosing them at first boot.
# CLIPMUX_PUBLIC_URL=https://video.example.com
# CLIPMUX_MEDIA_URL=https://media.example.net

# Backups: a copy a day goes to the data volume. Send them elsewhere (a
# Backblaze B2, R2 or S3 bucket; give it a key that can't delete) and keep the
# secrets key above with them. See https://clipmux.com/docs/self-host/operate/backups
# CLIPMUX_BACKUP_URL=s3://my-backups/clipmux?endpoint=https://s3.us-west-004.backblazeb2.com&region=us-west-004
# CLIPMUX_BACKUP_ACCESS_KEY_ID=
# CLIPMUX_BACKUP_SECRET_ACCESS_KEY=
# CLIPMUX_BACKUP_INTERVAL=1h

# Serverless providers (https://clipmux.com/docs/self-host/encoding/modal) run the image this server was
# built from; set this only to run another.
# CLIPMUX_WORKER_IMAGE=ghcr.io/visheshgubrani/clipmux:sha-...

# Host ports (compose.yml, compose.release.yml); the defaults are 80, 443 and
# 8080 on loopback for `clipmux admin`.
# CLIPMUX_HTTP_PORT=80
# CLIPMUX_HTTPS_PORT=443
# CLIPMUX_ADMIN_PORT=8080
