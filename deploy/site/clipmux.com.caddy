# clipmux.com: the static site in site/ (D133), served by the host's Caddy
# from the release `make site-deploy` last put in /srv/clipmux-site/current.
# The headers and redirects mirror site/public/_headers and _redirects; change
# both together. Cloudflare proxies the hostname, so the ACME challenge is
# HTTP-01 (TLS-ALPN can't pass through the proxy).
clipmux.com {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	root * /srv/clipmux-site/current
	encode zstd gzip

	# The installers are never copied here: they 302 to a GitHub release,
	# whose SHA256SUMS they check. Until v1.0.0 that is the newest release
	# candidate, because /releases/latest skips prereleases; at launch
	# (P6-T20) both go back to releases/latest/download (D136).
	redir /install.sh https://github.com/visheshgubrani/clipmux/releases/download/v1.0.0-rc.1/install.sh 302
	redir /install-agent.sh https://github.com/visheshgubrani/clipmux/releases/download/v1.0.0-rc.1/install-agent.sh 302
	redir /github https://github.com/visheshgubrani/clipmux 302

	# One URL per page, the one in the sitemap and the canonical tag:
	# /docs/build/ and /docs/build.html redirect to /docs/build, /index.html to /.
	# (Cloudflare's _redirects can't express these; Caddy is what serves the site.)
	@index path /index.html
	redir @index /{?query} 308
	@slash path_regexp slash ^(/.+)/$
	redir @slash {re.slash.1}{?query} 308
	@html {
		path_regexp html ^(/.+)\.html$
		not path /index.html
	}
	redir @html {re.html.1}{?query} 308

	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin
	header Strict-Transport-Security "max-age=31536000"
	header X-Frame-Options DENY
	header Permissions-Policy "camera=(), microphone=(), geolocation=()"
	@markdown path *.md
	header @markdown Content-Type "text/markdown; charset=utf-8"
	@text path /llms.txt /llms-full.txt /docs/*/llms-full.txt
	header @text Content-Type "text/plain; charset=utf-8"
	@search path /api/search
	header @search Content-Type "application/json; charset=utf-8"
	@hashed path /_next/static/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	# Screenshots and Open Graph images keep their names across builds: a day.
	@images path /screenshots/* /og/*
	header @images Cache-Control "public, max-age=86400"

	# The static export writes /docs/build as docs/build.html.
	try_files {path} {path}.html {path}/index.html
	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}

www.clipmux.com {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	redir https://clipmux.com{uri} permanent
}
