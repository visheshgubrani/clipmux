# TLS for ClipMux's public and media hostnames, with no hostname written here:
# Caddy asks the app before obtaining a certificate, and the app approves only
# the URLs set at first boot (or by CLIPMUX_PUBLIC_URL / CLIPMUX_MEDIA_URL).
{
	on_demand_tls {
		ask http://app:8080/_tls/ask
	}
}

(clipmux) {
	# The certificate check is for Caddy only.
	@internal path /_tls/*
	respond @internal 404
	reverse_proxy app:8080
}

https:// {
	tls {
		on_demand
	}
	import clipmux
}

# Plain HTTP serves first boot (http://<host>) and anything not yet on TLS.
http:// {
	import clipmux
}
