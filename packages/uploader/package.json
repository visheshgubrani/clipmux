{
  "name": "@clipmux/uploader",
  "version": "0.6.1",
  "description": "Upload files to ClipMux in resumable parts, straight to storage, from code or a drop-in <clipmux-uploader>.",
  "license": "MIT",
  "keywords": [
    "upload",
    "multipart",
    "resumable",
    "video",
    "clipmux",
    "web-component",
    "s3",
    "direct-upload",
    "self-hosted"
  ],
  "homepage": "https://clipmux.com/docs/reference/sdks/uploader",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visheshgubrani/clipmux.git",
    "directory": "packages/uploader"
  },
  "bugs": {
    "url": "https://github.com/visheshgubrani/clipmux/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test src/*.test.ts"
  },
  "peerDependencies": {
    "@types/react": ">=18"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
