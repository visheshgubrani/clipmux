{
  "name": "@clipmux/player",
  "version": "0.6.0",
  "description": "A Video.js player for ClipMux that refreshes expired playback tokens without losing its place.",
  "license": "MIT",
  "keywords": [
    "video",
    "hls",
    "player",
    "videojs",
    "clipmux",
    "web-component",
    "video-player",
    "signed-playback",
    "self-hosted"
  ],
  "homepage": "https://clipmux.com/docs/reference/sdks/player",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visheshgubrani/clipmux.git",
    "directory": "packages/player"
  },
  "bugs": {
    "url": "https://github.com/visheshgubrani/clipmux/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test src/*.test.ts"
  },
  "dependencies": {
    "@videojs/html": "10.2.0",
    "@videojs/hlsjs-video": "10.2.0",
    "hls.js": "1.6.19"
  },
  "peerDependencies": {
    "@types/react": ">=18"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
