# `npx @clipmux/node init --server https://video.example.com` writes the five
# CLIPMUX_* settings to .env.local; you don't copy them by hand. None has the
# NEXT_PUBLIC_ prefix, so none reaches the browser.
CLIPMUX_URL=https://video.example.com
CLIPMUX_API_KEY=
CLIPMUX_SIGNING_KID=
CLIPMUX_SIGNING_KEY=
CLIPMUX_WEBHOOK_SECRET=

# Optional: how long a playback token lasts (default 15m). The player asks
# the route for a new one before it runs out.
# LMS_TOKEN_TTL=15m
# Optional: where the lessons are kept (default .data/ here).
# LMS_DATA_DIR=.data
